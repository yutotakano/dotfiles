{{- $data := dict -}}
{{- $_ := set $data "machineContext" (promptChoiceOnce .data "machineContext" "Machine context" (list "personal" "work")) -}}
{{- $_ := set $data "gitName" (promptStringOnce .data "gitName" "Git Name") -}}
{{- $_ := set $data "gitEmail" (promptStringOnce .data "gitEmail" "Git Email address") -}}

[data.data]
{{ $data | toToml }}

[diff]
  command = "git"
  args = ["-c", "core.autocrlf=false", "diff", "--no-index", "--ignore-all-space", "--ignore-blank-lines"]
  pager = "delta"
