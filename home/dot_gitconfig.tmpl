[core]
  hideDotFiles = false
  pager = delta

{{ if eq .chezmoi.os "windows" }}
  # Windows-specific settings
  editor = micro
  autocrlf = true
  longpaths = true
  symlinks = false
{{ end }}

{{ if eq .chezmoi.os "darwin" }}
  # macOS-specific settings
  autocrlf = input
  pager = LESS=FX delta # https://github.com/dandavison/delta
{{ end }}

[alias]
  conflicts = diff --name-only --diff-filter=U
  branches = for-each-ref --sort=-committerdate --format='%(refname:short) - (%(color:green)%(committerdate:relative)%(color:reset))' refs/heads/
  statsu = status
  mr = !sh -c 'git fetch $1 merge-requests/$2/head:mr-$1-$2 && git checkout mr-$1-$2' -

{{ if eq .data.machineContext "personal" }}
# Allow hooks to run everywhere for personal machines
[safe]
  directory = *
{{ end }}

[user]
  name = {{ .data.gitName }}
  email = {{ .data.gitEmail }}

# Overleaf needs to explicitly set credential provider
[credential "https://git.overleaf.com"]
  provider = generic

[pull]
  ff = only
  rebase = false

[blame]
  color = repeatedLines

[color.blame]
  repeatedLines = black

[init]
  defaultBranch = main

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[interactive]
  diffFilter = delta --color-only

[add.interactive]
  useBuiltin = false # required for git 2.37.0

[delta]
  navigate = true    # use n and N to move between diff sections
  light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
  dark = true
  line-numbers = true
  theme = visual-studio-dark-plus

[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
